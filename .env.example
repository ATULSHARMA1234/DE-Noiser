# 🛡️ Semantic Log De-Noiser Configuration

# --- Intelligence (LLM) Settings ---
# Required for --intelligence flag
SLD_LLM_API_KEY=your_api_key_here
SLD_LLM_MODEL=llama-3.1-8b-instant
SLD_LLM_BASE_URL=https://api.groq.com/openai/v1

# --- General Settings ---
SLD_LOG_LEVEL=INFO
SLD_REDACT_BY_DEFAULT=True

# --- Security / Auth (mandatory in production) ---
# Signing key for platform JWTs. Required outside of tests; the app refuses to
# start without it. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Bootstrap password for the seeded admin@semanticos.io user. If unset in
# production, a random password is generated and logged once at first startup.
SEMANTICOS_ADMIN_PASSWORD=

# Static API key accepted for log/trace ingestion (X-API-Key). No safe default.
INGEST_API_KEY=

# Set to "true" ONLY for local/sandbox use to enable the built-in mock SSO IdP.
# Must remain false/unset in production — it issues real tokens without verifying
# any IdP assertion.
SSO_ALLOW_MOCK=false

# Comma-separated allowlist of browser origins permitted to call the API (CORS).
# Never use "*" on this credentialed API. Set to your frontend origin(s).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Clustering Settings ---
# SLD_MIN_CLUSTER_SIZE=5
# SLD_MIN_SAMPLES=3
