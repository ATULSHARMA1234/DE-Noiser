SLD_LLM_MODEL=llama-3.1-8b-instant
SLD_LLM_BASE_URL=https://api.groq.com/openai/v1

# --- General Settings ---
SLD_LOG_LEVEL=INFO
SLD_REDACT_BY_DEFAULT=True

