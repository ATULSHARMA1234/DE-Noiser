# 🛡️ Semantic Log De-Noiser Configuration

# --- Intelligence (LLM) Settings ---
# Required for --intelligence flag
SLD_LLM_API_KEY=your_api_key_here
SLD_LLM_MODEL=llama-3.1-8b-instant
SLD_LLM_BASE_URL=https://api.groq.com/openai/v1

# --- General Settings ---
SLD_LOG_LEVEL=INFO
SLD_REDACT_BY_DEFAULT=True

# --- Security / Auth (mandatory in production) ---
# Signing key for platform JWTs. Required outside of tests; the app refuses to
# start without it. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Bootstrap password for the seeded admin@semanticos.io user. If unset in
# production, a random password is generated and logged once at first startup.
SEMANTICOS_ADMIN_PASSWORD=

# Static API key accepted for log/trace ingestion (X-API-Key). No safe default.
INGEST_API_KEY=

# Set to "true" ONLY for local/sandbox use to enable the built-in mock SSO IdP.
# Must remain false/unset in production — it issues real tokens without verifying
# any IdP assertion.
SSO_ALLOW_MOCK=false

# Comma-separated allowlist of browser origins permitted to call the API (CORS).
# Never use "*" on this credentialed API. Set to your frontend origin(s).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Infrastructure credentials (docker-compose) ---
# docker-compose reads this file for ${VAR} substitution. The passwords below
# have NO defaults in the compose files — `docker compose up` fails fast until
# you set them. Use strong, unique values; do not commit your real .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=semanticos
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me-clickhouse
CLICKHOUSE_DB=default
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-minio

# --- Object storage (S3/MinIO) used by the API ---
# Leave blank to configure via the in-app Settings UI instead.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=semanticos-logs
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Clustering Settings ---
# SLD_MIN_CLUSTER_SIZE=5
# SLD_MIN_SAMPLES=3

# --- Multi-tenancy (hosting several customer organisations) ---
# Operator credential for /platform/* — onboarding, offboarding, and registering
# the email domains that route SSO/SCIM identities to an organisation. This is
# the vendor's credential, deliberately separate from the ADMIN role, which
# belongs to a customer's own administrator. Leave unset on a single-customer
# deployment: the endpoints stay disabled (403) until it is set. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SEMANTICOS_PLATFORM_TOKEN=

# Deployment-wide SCIM token, for a deployment serving one customer. Once any
# organisation registers an email domain the deployment is shared, this token no
# longer identifies which organisation an IdP may manage, and it is refused —
# issue per-organisation tokens via /platform/tenants/{id}/scim-token/rotate.
SCIM_BEARER_TOKEN=

# --- Secret encryption ---
# Key material for values stored recoverably in the database (alert destination
# URLs and per-organisation SCIM tokens, both bearer credentials). Derived from
# JWT_SECRET_KEY
# when unset, so existing deployments gain encryption with no new setting.
# Set this explicitly if you rotate JWT_SECRET_KEY, or stored secrets become
# undecryptable. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SEMANTICOS_ENCRYPTION_KEY=

# --- Outbound alert destinations (SSRF guard) ---
# Alert webhooks must be https and must not resolve to private, loopback or
# link-local addresses. Name internal hosts here to exempt them (comma-separated).
SEMANTICOS_WEBHOOK_ALLOWED_HOSTS=
# Allow plaintext http destinations. Local development only — alert payloads
# carry log content.
SEMANTICOS_WEBHOOK_ALLOW_HTTP=false

# --- Session cookies ---
# "lax" when the UI and API share an origin (the bundled nginx/compose setup).
# Use "none" for a split-origin deployment (UI on a CDN, API on its own host);
# that forces Secure and relies on the double-submit CSRF token.
SEMANTICOS_COOKIE_SAMESITE=lax

# --- Request and ingest limits ---
# Largest request body accepted on any route (bytes).
SEMANTICOS_MAX_BODY_BYTES=33554432
# Largest single uploaded log file (bytes). Streamed to disk, not buffered.
SEMANTICOS_MAX_UPLOAD_BYTES=536870912
# Maximum log entries in one POST /ingest call.
SEMANTICOS_MAX_INGEST_BATCH=10000
# Maximum characters in a single log entry.
SEMANTICOS_MAX_INGEST_ENTRY_CHARS=262144

# --- Redaction policy (personal data) ---
# Secrets (tokens, keys, passwords) are always redacted and are not
# configurable. These govern personal-data categories, which are jurisdictional:
# an IP address is personal data under GDPR, but masking it also removes the
# field an engineer needs to trace a network fault. Default is on for all.
SLD_REDACT_IP=true
SLD_REDACT_PHONE=true
SLD_REDACT_IBAN=true
SLD_REDACT_DOB=true
SLD_REDACT_PASSPORT=true
SLD_REDACT_NATIONAL_ID=true
SLD_REDACT_MAC=true
